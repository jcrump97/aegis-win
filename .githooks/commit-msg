#!/bin/sh
# Enforce prepended commit type: e.g., (feat) message, (fix) message, (doc) message, (chore) message
COMMIT_MSG_FILE=$1
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")
if ! echo "$FIRST_LINE" | grep -Eq '^\((feat|fix|doc|chore|test|refactor|security|perf)\) .+'; then
  echo "[Git Hook Error] Commit message must start with a prepended type tag, e.g. '(feat) Add module'"
  echo "Actual: $FIRST_LINE"
  exit 1
fi

# No AI-tool attribution trailers or footers in commit messages (AGENT.md section 2)
ATTRIBUTION_PATTERN='^co-authored-by:.*(claude|anthropic|copilot|gemini|openai|chatgpt)|generated with \[?(claude|copilot|gemini|chatgpt)'
if grep -v '^#' "$COMMIT_MSG_FILE" | grep -Eiq "$ATTRIBUTION_PATTERN"; then
  echo "[Git Hook Error] Remove AI attribution trailers/footers from the commit message (credit goes in the README)."
  exit 1
fi
